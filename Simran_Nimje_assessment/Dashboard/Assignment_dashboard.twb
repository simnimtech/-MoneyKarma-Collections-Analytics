      <aliases enabled='yes' />
      <column caption='Recovered Account Flag' datatype='integer' name='[Calculation_6736705970458624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [account_id] :&#10;    MAX(&#10;        IF [payment_status] = &quot;SUCCESS&quot;&#10;        THEN 1&#10;        ELSE 0&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='    Recovery Coverage Percentage' datatype='real' name='[Calculation_6736705970630657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_6736705970458624])&#10;/&#10;COUNTD([account_id])' />
      </column>
      <column caption='Loan Recovery Coverage' datatype='real' name='[Calculation_6736705971695618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [Calculation_6736705970458624] = 1&#10;    THEN [account_id]&#10;    END&#10;)&#10;/&#10;COUNTD([account_id])' />
      </column>
      <column caption='MOM Growth %' datatype='real' name='[Calculation_6736705973293059]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([amount]) - LOOKUP(SUM([amount]), -1))&#10;/&#10;LOOKUP(SUM([amount]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
